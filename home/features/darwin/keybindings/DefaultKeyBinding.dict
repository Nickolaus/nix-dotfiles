{
    "\UF729" = "moveToBeginningOfLine:";                          // Home
    "\UF72B" = "moveToEndOfLine:";                                // End
    "$\UF729" = "moveToBeginningOfLineAndModifySelection:";      // Shift + Home
    "$\UF72B" = "moveToEndOfLineAndModifySelection:";            // Shift + End

    "@\UF729" = "moveToBeginningOfDocument:";                    // Ctrl + Home
    "@\UF72B" = "moveToEndOfDocument:";                          // Ctrl + End
    "@$\UF729" = "moveToBeginningOfDocumentAndModifySelection:"; // Ctrl + Shift + Home
    "@$\UF72B" = "moveToEndOfDocumentAndModifySelection:";       // Ctrl + Shift + End

    "@\UF702" = "moveWordLeft:";                                 // Ctrl + Left
    "@$\UF702" = "moveWordLeftAndModifySelection:";              // Ctrl + Shift + Left
    "@\UF703" = "moveWordRight:";                                // Ctrl + Right
    "@$\UF703" = "moveWordRightAndModifySelection:";             // Ctrl + Shift + Right

    "@\UF700" = "moveParagraphBackward:";                        // Ctrl + Up
    "@$\UF700" = "moveParagraphBackwardAndModifySelection:";     // Ctrl + Shift + Up
    "@\UF701" = "moveParagraphForward:";                         // Ctrl + Down
    "@$\UF701" = "moveParagraphForwardAndModifySelection:";      // Ctrl + Shift + Down

    "@\b" = "deleteWordBackward:";                               // Ctrl + Backspace
    "@\UF728" = "deleteWordForward:";                            // Ctrl + Delete

    "^@\UF702" = "moveToBeginningOfLine:";                      // Ctrl+Alt + Left (built-in)
    "^$@\UF702" = "moveToBeginningOfLineAndModifySelection:";    // Ctrl+Alt+Shift + Left (built-in)
    "^@\UF703" = "moveToEndOfLine:";                            // Ctrl+Alt + Right (built-in)
    "^$@\UF703" = "moveToEndOfLineAndModifySelection:";          // Ctrl+Alt+Shift + Right (built-in)

    "~@\UF702" = "moveToBeginningOfLine:";                      // Ctrl+Alt + Left (external)
    "~$@\UF702" = "moveToBeginningOfLineAndModifySelection:";    // Ctrl+Alt+Shift + Left (external)
    "~@\UF703" = "moveToEndOfLine:";                            // Ctrl+Alt + Right (external)
    "~$@\UF703" = "moveToEndOfLineAndModifySelection:";          // Ctrl+Alt+Shift + Right (external)
}
